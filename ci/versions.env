# CI tool versions and job time limits: the one place to change them (#346).
#
# GitHub cannot read a file for a job's timeout-minutes or an action's inputs, so workflows
# keep those as literals, and each such line ends with a `# versions: KEY` marker.
# scripts/check_ci_config.py (run by the Rust job) fails when a marked line does not carry
# the value below, when a job has no marked time limit, or when a pinned version is written
# without a marker. Scripts and the Dockerfile read the values directly where they can.
# Plain KEY=value lines only, no quoting or expansion.

# Rust toolchain: rust-toolchain.toml, the Dockerfile's rust image and the maturin action
# must name this exact release. Bump it in its own pull request (CONTRIBUTING.md).
RUST_VERSION=1.100.0

# Python wheels and bindings.
MATURIN_VERSION=1.15.0
PYTHON_MIN=3.10
PYTHON_MAX=3.14
# Browser consumers: ci/browser/package-lock.json pins the npm packages by integrity hash.
NODE_VERSION=22
# Test runner of the slow portable targets.
NEXTEST_VERSION=0.9.148

# Native geospatial base (Dockerfile ARG defaults, geobase.yml and the tarball cache).
PROJ_VERSION=9.8.1
PROJ_SHA256=af5b731c145c1d13c4e3b4eeb7d167e94e845e440f71e3496b4ed8dae0291960
GDAL_VERSION=3.12.4
GDAL_SHA256=68844ae29557b7efae4292c3b4cb3a3b8a79d14b765b89c5a7b17cbae7fa715a
GEOBASE_REPOSITORY=ghcr.io/bendyson-arch/rusty-tiles-geobase

# Job time limits in minutes.
TIMEOUT_SHORT=5
TIMEOUT_GATE=15
TIMEOUT_RUST=50
TIMEOUT_PYTHON=30
TIMEOUT_PYTHON_WHEEL=25
TIMEOUT_NATIVE=40
TIMEOUT_CRS_ALLOWLIST=60
# Raised from 60 by #376 (Intel macOS, no longer a target, took 51-57 minutes); Windows, now
# the slowest portable target, took about 38 minutes before the release build was added.
TIMEOUT_PORTABLE=90
# The nightly run tests the whole suite, hlod_acceptance included, on all four portable
# targets and then builds, packages and smoke-tests the release archive.
TIMEOUT_PORTABLE_NIGHTLY=120
TIMEOUT_ENCODER_LINK=45
# The pure-Rust Basis job: lint and the codec and decoded-view tests with feature pure-rust-basis.
TIMEOUT_PURE_RUST_BASIS=30
TIMEOUT_CONTAINER=45
TIMEOUT_RELEASE_ACCEPTANCE=30
TIMEOUT_WHEEL=45
TIMEOUT_BLENDER=40
TIMEOUT_BLENDER_DISTRIBUTION=15
# A release or dev build that cannot reuse CI artifacts builds and tests from source (#345).
TIMEOUT_FALLBACK_BUILD=90
TIMEOUT_GEOBASE=120
# Smoke test of an archive or wheel set taken from the CI run.
TIMEOUT_SMOKE=20
TIMEOUT_PUBLISH=15

# Targets and runner labels dropped from CI and releases (0.4.1 drops Intel macOS; the
# macos-*-large runners, macos-latest-large included, are Intel, the -xlarge ones Apple
# Silicon). Comma separated; check_ci_config.py fails if a workflow, action or the
# artifact-reuse script names one outside a comment.
UNSUPPORTED_TARGETS=x86_64-apple-darwin
UNSUPPORTED_RUNNERS=macos-13,macos-13-large,macos-14-large,macos-15-intel,macos-15-large,macos-26-intel,macos-26-large,macos-latest-large

# Days a CI run keeps the archives and wheels a release or dev build can reuse: long on main,
# where tags are cut, short elsewhere (dev builds reuse the same night's run).
ARTIFACT_RETENTION_DAYS_MAIN=90
ARTIFACT_RETENTION_DAYS=14
