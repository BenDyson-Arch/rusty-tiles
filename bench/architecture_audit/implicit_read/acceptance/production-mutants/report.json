  {
   "name": "ge-vs-gt-on-A",
   "patchSha256": "1d754ad00829df90a59511a382fe969777f94ecccbe1ee07cef3ee5e67420575",
   "paired": "A-8, A-9",
   "timingCase": null,
   "timedOut": false,
   "controlsFlipped": [],
   "corpusFlipped": [],
   "boundBreaches": {},
   "probeClausesFailed": [],
   "pairedFlipped": [],
   "unitTestsFailed": [
    "content_integrity::implicit::availability::tests::levels_rule"
   ],
   "diagnosis": "Rerun after oracle amendment 5 (A-8 ships subtrees/6/18/2.subtree and content/6/18/2.glb, merge 3d23cd5): A-8 does NOT flip. Clean production refuses at the parent's rule ('child subtree beyond availableLevels'); under the mutant the child subtree is admitted and its own root tile, at global level A = 6, is refused by the levels rule ('available tile beyond availableLevels'). This is verdict-equivalent for every input: an admitted child subtree must have its root tile available (\u00a72a step 5; constant-0 tile availability is disallowed), and a child subtree at global level g >= A puts that tile at level >= A, which \u00a72a step 6 refuses. So the mutant cannot cause a false Accept; it changes only which rule refuses. Parity compares verdict categories, not reasons, so no control can flip it. The levels_rule unit test fails under it."
  },
