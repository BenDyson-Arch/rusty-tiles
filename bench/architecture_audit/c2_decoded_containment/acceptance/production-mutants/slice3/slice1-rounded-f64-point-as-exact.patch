+    /// A binary64 approximation of a value (top two limbs).
+    pub(super) fn to_f64(&self, d: D) -> f64 {
+        let h = self.head(d);
+        if h.len == 0 {
+            return 0.0;
+        }
+        let k = h.len.min(2);
+        let m = (h.len - k..h.len)
+            .rev()
+            .fold(0f64, |m, i| m * 18446744073709551616.0 + self.v[h.at + i] as f64);
+        let e = h.exp + 64 * (h.len - k) as i64;
+        let x = m * 2f64.powi((e / 2) as i32) * 2f64.powi((e - e / 2) as i32);
+        if h.neg {
+            -x
+        } else {
+            x
+        }
+    }
