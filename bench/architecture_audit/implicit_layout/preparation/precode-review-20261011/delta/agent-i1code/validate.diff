+    /// A one-point GLB at the origin.
+    pub(super) fn point_glb() -> Vec<u8> {
+        let doc = json!({
+            "asset":{"version":"2.0"},"scene":0,"scenes":[{"nodes":[0]}],"nodes":[{"mesh":0}],
+            "buffers":[{"byteLength":12}],"bufferViews":[{"buffer":0,"byteLength":12}],
