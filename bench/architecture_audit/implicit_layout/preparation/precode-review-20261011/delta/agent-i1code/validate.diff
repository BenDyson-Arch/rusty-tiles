+            [] => {}
+            [one] => root["content"] = json!({"uri":one}),
+            many => root["contents"] = many.iter().map(|uri| json!({"uri":uri})).collect(),
+        }
+        root
+    }
+    pub(super) fn tileset(root: Value) -> Vec<u8> {
